@page "/clients"
@rendermode InteractiveServer
@using TrackMyTime.Web.Models
@using TrackMyTime.Web.Repositories
@inject IClientRepository ClientRepository

<MudText Typo="Typo.h4" GutterBottom="true">Clients</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="8">
            <MudTextField @bind-Value="_newName" Label="@(_editingId is null ? "New client name" : "Client name")" Immediate="true" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center ga-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@string.IsNullOrWhiteSpace(_newName)">
                @(_editingId is null ? "Add client" : "Save changes")
            </MudButton>
            @if (_editingId is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="CancelEdit">Cancel</MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_clients is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudTable Items="_clients" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Name</MudTd>
            <MudTd>@(context.IsActive ? "Active" : "Archived")</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => StartEdit(context))" />
                <MudButton Size="Size.Small" OnClick="@(() => ToggleActiveAsync(context))">
                    @(context.IsActive ? "Archive" : "Restore")
                </MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<Client>? _clients;
    private string _newName = "";
    private int? _editingId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _clients = (await ClientRepository.GetAllAsync(includeInactive: true)).ToList();

    private void StartEdit(Client client)
    {
        _editingId = client.Id;
        _newName = client.Name;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _newName = "";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        if (_editingId is null)
        {
            await ClientRepository.CreateAsync(new Client { Name = _newName.Trim() });
        }
        else
        {
            var existing = _clients!.Single(c => c.Id == _editingId);
            await ClientRepository.UpdateAsync(new Client { Id = existing.Id, Name = _newName.Trim(), IsActive = existing.IsActive });
        }

        CancelEdit();
        await LoadAsync();
    }

    private async Task ToggleActiveAsync(Client client)
    {
        await ClientRepository.SetActiveAsync(client.Id, !client.IsActive);
        await LoadAsync();
    }
}
