@page "/settings"
@rendermode InteractiveServer
@using System.Globalization
@using Microsoft.Data.Sqlite
@using Microsoft.Extensions.Localization
@using TrackMyTime.Web.Models
@using TrackMyTime.Web.Repositories
@using TrackMyTime.Web.Services
@inject INominalHoursRepository NominalHoursRepository
@inject MqttPublisherService MqttPublisher
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<MudText Typo="Typo.h4" GutterBottom="true">@Localizer["Settings_Title"]</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">@Localizer["Settings_HAIntegration"]</MudText>
    <MudChip T="string" Color="@(MqttPublisher.IsConnected ? Color.Success : Color.Default)"
             Icon="@Icons.Material.Filled.Circle">
        MQTT: @(MqttPublisher.IsConnected ? Localizer["Settings_MqttConnected"] : Localizer["Settings_MqttNotConnected"])
    </MudChip>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
        @Localizer["Settings_HADescription"]
    </MudText>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">@Localizer["Settings_NominalHoursHistory"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        @Localizer["Settings_NominalHoursDescription"]
    </MudText>

    @if (_settings is not null)
    {
        <MudTable Items="_settings" Dense="true" Class="mb-4">
            <HeaderContent>
                <MudTh>@Localizer["Settings_EffectiveFrom"]</MudTh>
                <MudTh>@Localizer["Settings_WeeklyHours"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EffectiveFrom.ToString("d MMM yyyy")</MudTd>
                <MudTd>@context.WeeklyHours.ToString("0.##")</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => StartEdit(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => DeleteAsync(context.Id))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="@Localizer["Settings_EffectiveFrom"]" @bind-Date="_newEffectiveFrom"
                            FirstDayOfWeek="DayOfWeek.Monday" ShowWeekNumbers="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            @* Backlog #19: unlike plain ToString("0.##") (which already follows the ambient
               CultureInfo.CurrentCulture), MudNumericField parses/formats using its own Culture
               parameter - defaulting to invariant, where "," is a thousands separator, not a
               decimal point (so typing "40,25" on a Danish keyboard silently became 4025). Must
               be set explicitly to match the request culture set in Program.cs/culture/set. *@
            <MudNumericField T="decimal" Label="@Localizer["Settings_WeeklyHours"]" @bind-Value="_newWeeklyHours" Min="0m" Step="0.5m"
                             Culture="CultureInfo.CurrentCulture" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center ga-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@(_newEffectiveFrom is null)">
                @(_editingId is null ? Localizer["Common_Add"] : Localizer["Common_SaveChanges"])
            </MudButton>
            @if (_editingId is not null)
            {
                <MudButton Variant="Variant.Text" OnClick="CancelEdit">@Localizer["Common_Cancel"]</MudButton>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private List<NominalHoursSetting>? _settings;
    private DateTime? _newEffectiveFrom = DateTime.Today;
    private decimal _newWeeklyHours = 37.5m;
    private int? _editingId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        _settings = (await NominalHoursRepository.GetAllAsync()).OrderByDescending(s => s.EffectiveFrom).ToList();

    private void StartEdit(NominalHoursSetting setting)
    {
        _editingId = setting.Id;
        _newEffectiveFrom = setting.EffectiveFrom.ToDateTime(TimeOnly.MinValue);
        _newWeeklyHours = setting.WeeklyHours;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _newEffectiveFrom = DateTime.Today;
        _newWeeklyHours = 37.5m;
    }

    private async Task SaveAsync()
    {
        if (_newEffectiveFrom is null)
        {
            return;
        }

        var setting = new NominalHoursSetting
        {
            Id = _editingId ?? 0,
            EffectiveFrom = DateOnly.FromDateTime(_newEffectiveFrom.Value),
            WeeklyHours = _newWeeklyHours,
        };

        try
        {
            if (_editingId is null)
            {
                await NominalHoursRepository.CreateAsync(setting);
            }
            else
            {
                await NominalHoursRepository.UpdateAsync(setting);
            }
        }
        catch (SqliteException ex) when (ex.SqliteErrorCode == 19)
        {
            Snackbar.Add(Localizer["Settings_DuplicateEffectiveFrom"].Value, Severity.Error);
            return;
        }

        CancelEdit();
        MqttPublisher.RequestRefresh();
        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        await NominalHoursRepository.DeleteAsync(id);
        if (_editingId == id)
        {
            CancelEdit();
        }
        MqttPublisher.RequestRefresh();
        await LoadAsync();
    }
}
