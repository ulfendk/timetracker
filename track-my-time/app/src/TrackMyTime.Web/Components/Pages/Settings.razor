@page "/settings"
@rendermode InteractiveServer
@using TrackMyTime.Web.Models
@using TrackMyTime.Web.Repositories
@using TrackMyTime.Web.Services
@inject INominalHoursRepository NominalHoursRepository
@inject MqttPublisherService MqttPublisher

<MudText Typo="Typo.h4" GutterBottom="true">Settings</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">Home Assistant integration</MudText>
    <MudChip T="string" Color="@(MqttPublisher.IsConnected ? Color.Success : Color.Default)"
             Icon="@Icons.Material.Filled.Circle">
        MQTT: @(MqttPublisher.IsConnected ? "connected" : "not connected")
    </MudChip>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
        Requires an MQTT broker configured in Home Assistant (e.g. the Mosquitto broker app) —
        Track My Time discovers it automatically and needs no setup here.
    </MudText>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">Nominal hours history</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Your contracted weekly hours (e.g. 37.5). Add a new entry when it changes — history is
        kept so past weeks/months are still compared against the rate that applied at the time.
    </MudText>

    @if (_settings is not null)
    {
        <MudTable Items="_settings" Dense="true" Class="mb-4">
            <HeaderContent>
                <MudTh>Effective from</MudTh>
                <MudTh>Weekly hours</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EffectiveFrom.ToString("d MMM yyyy")</MudTd>
                <MudTd>@context.WeeklyHours.ToString("0.##")</MudTd>
            </RowTemplate>
        </MudTable>
    }

    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="Effective from" @bind-Date="_newEffectiveFrom" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudNumericField T="decimal" Label="Weekly hours" @bind-Value="_newWeeklyHours" Min="0m" Step="0.5m" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync" Disabled="@(_newEffectiveFrom is null)">
                Add
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private List<NominalHoursSetting>? _settings;
    private DateTime? _newEffectiveFrom = DateTime.Today;
    private decimal _newWeeklyHours = 37.5m;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() =>
        _settings = (await NominalHoursRepository.GetAllAsync()).OrderByDescending(s => s.EffectiveFrom).ToList();

    private async Task AddAsync()
    {
        if (_newEffectiveFrom is null)
        {
            return;
        }
        await NominalHoursRepository.CreateAsync(new NominalHoursSetting
        {
            EffectiveFrom = DateOnly.FromDateTime(_newEffectiveFrom.Value),
            WeeklyHours = _newWeeklyHours,
        });
        MqttPublisher.RequestRefresh();
        await LoadAsync();
    }
}
