@page "/billing"
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@using TrackMyTime.Web.Repositories
@using TrackMyTime.Web.Services
@inject ITimeEntryRepository TimeEntryRepository
@inject IStringLocalizer<SharedResource> Localizer

<MudText Typo="Typo.h4" GutterBottom="true">@Localizer["Billing_Title"]</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">@Localizer["Billing_Description"]</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudGrid>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="@Localizer["Billing_From"]" @bind-Date="_fromDate" FirstDayOfWeek="DayOfWeek.Monday" ShowWeekNumbers="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker Label="@Localizer["Billing_To"]" @bind-Date="_toDate" FirstDayOfWeek="DayOfWeek.Monday" ShowWeekNumbers="true" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync"
                       Disabled="@(_fromDate is null || _toDate is null)">
                @Localizer["Billing_Generate"]
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_rows is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_rows.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["Billing_NothingLogged"]</MudText>
}
else
{
    <MudTable Items="_rows" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>@Localizer["Common_Client"]</MudTh>
            <MudTh>@Localizer["Common_Project"]</MudTh>
            <MudTh>@Localizer["Common_Hours"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Client</MudTd>
            <MudTd>@context.Project</MudTd>
            <MudTd>@context.Hours.ToString("0.##")</MudTd>
        </RowTemplate>
        <FooterContent>
            <MudTd Class="mud-table-cell-custom-group">@Localizer["Billing_Total"]</MudTd>
            <MudTd></MudTd>
            <MudTd>@_rows.Sum(r => r.Hours).ToString("0.##")</MudTd>
        </FooterContent>
    </MudTable>
}

@code {
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private List<(string Client, string Project, decimal Hours)>? _rows;

    protected override async Task OnInitializedAsync()
    {
        var (from, to) = DateRanges.MonthContaining(DateOnly.FromDateTime(DateTime.Now));
        _fromDate = from.ToDateTime(TimeOnly.MinValue);
        _toDate = to.ToDateTime(TimeOnly.MinValue);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_fromDate is null || _toDate is null)
        {
            return;
        }

        var from = DateOnly.FromDateTime(_fromDate.Value);
        var to = DateOnly.FromDateTime(_toDate.Value);
        var entries = await TimeEntryRepository.GetByDateRangeAsync(from, to);

        _rows = entries
            .GroupBy(e => (e.ClientName, e.ProjectName))
            .Select(g => (Client: g.Key.ClientName, Project: g.Key.ProjectName, Hours: g.Sum(e => e.DurationMinutes) / 60m))
            .OrderBy(r => r.Client).ThenBy(r => r.Project)
            .ToList();
    }
}
