@page "/data"
@rendermode InteractiveServer
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using TrackMyTime.Web.Models
@using TrackMyTime.Web.Models.Export
@using TrackMyTime.Web.Models.Legacy
@using TrackMyTime.Web.Repositories
@using TrackMyTime.Web.Services
@inject ExportImportService ExportImportService
@inject IClientRepository ClientRepository
@inject IProjectRepository ProjectRepository
@inject MqttPublisherService MqttPublisher
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Data</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">Export</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Downloads every client, project, time entry, day off, and nominal-hours setting as one
        JSON file — a backup, and the format the import below expects.
    </MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="api/export" Target="_blank"
               StartIcon="@Icons.Material.Filled.Download">
        Download export
    </MudButton>
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">Import</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Loads a Track My Time export JSON file. Clients/projects are matched by name so
        re-importing your own data doesn't duplicate them.
    </MudText>

    <MudFileUpload T="IBrowserFile" OnFilesChanged="OnFileSelectedAsync" Accept=".json" />

    @if (_fileError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_fileError</MudAlert>
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" GutterBottom="true">Import from another time tracker</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        One-time conversion for a different app's export (a "dates" JSON with start/end/break
        intervals per day). Pick the date range to bring in and the existing client/project to
        assign it to, then review the same conflict preview below before applying.
    </MudText>

    <MudFileUpload T="IBrowserFile" OnFilesChanged="OnLegacyFileSelectedAsync" Accept=".json" />

    @if (_legacyError is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_legacyError</MudAlert>
    }

    @if (_legacyExport is not null && _legacyRange is not null)
    {
        <MudGrid Class="mt-3">
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="From" @bind-Date="_legacyFrom"
                                MinDate="_legacyRange.Value.Min.ToDateTime(TimeOnly.MinValue)"
                                MaxDate="_legacyRange.Value.Max.ToDateTime(TimeOnly.MinValue)"
                                FirstDayOfWeek="DayOfWeek.Monday" ShowWeekNumbers="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="To" @bind-Date="_legacyTo"
                                MinDate="_legacyRange.Value.Min.ToDateTime(TimeOnly.MinValue)"
                                MaxDate="_legacyRange.Value.Max.ToDateTime(TimeOnly.MinValue)"
                                FirstDayOfWeek="DayOfWeek.Monday" ShowWeekNumbers="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" Label="Client" @bind-Value="_legacyClientId">
                    @foreach (var client in _clients ?? [])
                    {
                        <MudSelectItem T="int" Value="@client.Id">@client.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" Label="Project" @bind-Value="_legacyProjectId">
                    @foreach (var project in (_projects ?? []).Where(p => p.ClientId == _legacyClientId))
                    {
                        <MudSelectItem T="int" Value="@project.Id">@project.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConvertLegacyAsync"
                           Disabled="@(_legacyFrom is null || _legacyTo is null || _legacyClientId == 0 || _legacyProjectId == 0)">
                    Convert &amp; preview
                </MudButton>
            </MudItem>
        </MudGrid>
    }
</MudPaper>

@if (_document is not null && _preview is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" GutterBottom="true">Review before applying</MudText>
        <MudText Typo="Typo.body1">
            @_preview.TotalIncomingTimeEntries time entries, @_preview.TotalIncomingDaysOff days off,
            @_preview.NewClientCount new client(s), @_preview.NewProjectCount new project(s).
        </MudText>

        @if (_preview.ConflictingTimeEntryDates.Count > 0 || _preview.ConflictingDayOffDates.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">
                @_preview.ConflictingTimeEntryDates.Count date(s) already have time entries, and
                @_preview.ConflictingDayOffDates.Count date(s) already have a day off recorded.
                Choose how to handle these before applying.
            </MudAlert>

            <MudRadioGroup T="ConflictResolution?" @bind-Value="_resolution" Class="mt-2">
                <MudRadio T="ConflictResolution?" Value="ConflictResolution.Skip">Skip conflicting dates — leave existing data untouched</MudRadio>
                <MudRadio T="ConflictResolution?" Value="ConflictResolution.Overwrite">Overwrite conflicting dates with the imported data</MudRadio>
            </MudRadioGroup>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-2">No conflicting dates.</MudText>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="ApplyAsync"
                   Disabled="@(RequiresResolutionChoice && _resolution is null)">
            Apply import
        </MudButton>
    </MudPaper>
}

@if (_resultMessage is not null)
{
    <MudAlert Severity="Severity.Success" Class="mb-4">@_resultMessage</MudAlert>
}

@code {
    private List<Client>? _clients;
    private List<ProjectWithClient>? _projects;

    private ExportDocument? _document;
    private ImportPreview? _preview;
    private ConflictResolution? _resolution;
    private string? _fileError;
    private string? _resultMessage;

    private LegacyExport? _legacyExport;
    private (DateOnly Min, DateOnly Max)? _legacyRange;
    private DateTime? _legacyFrom;
    private DateTime? _legacyTo;
    private int _legacyClientId;
    private int _legacyProjectId;
    private string? _legacyError;

    private bool RequiresResolutionChoice =>
        _preview is { ConflictingTimeEntryDates.Count: > 0 } or { ConflictingDayOffDates.Count: > 0 };

    protected override async Task OnInitializedAsync()
    {
        _clients = (await ClientRepository.GetAllAsync()).ToList();
        _projects = (await ProjectRepository.GetAllAsync()).ToList();
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _fileError = null;
        _resultMessage = null;
        _document = null;
        _preview = null;
        _resolution = null;

        var file = args.File;

        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            _document = await JsonSerializer.DeserializeAsync<ExportDocument>(stream);
            if (_document is null)
            {
                _fileError = "That file didn't contain a valid export document.";
                return;
            }
            _preview = await ExportImportService.BuildPreviewAsync(_document);
        }
        catch (JsonException)
        {
            _fileError = "That file isn't valid JSON, or isn't a Track My Time export.";
        }
    }

    private async Task OnLegacyFileSelectedAsync(InputFileChangeEventArgs args)
    {
        _legacyError = null;
        _resultMessage = null;
        _document = null;
        _preview = null;
        _resolution = null;
        _legacyExport = null;
        _legacyRange = null;

        try
        {
            using var reader = new StreamReader(args.File.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024));
            var json = await reader.ReadToEndAsync();
            _legacyExport = LegacyImportConverter.Parse(json);
            _legacyRange = LegacyImportConverter.GetDateRange(_legacyExport);
            if (_legacyRange is null)
            {
                _legacyError = "That file didn't contain any recognizable dated entries.";
                _legacyExport = null;
                return;
            }
            _legacyFrom = _legacyRange.Value.Min.ToDateTime(TimeOnly.MinValue);
            _legacyTo = _legacyRange.Value.Max.ToDateTime(TimeOnly.MinValue);
            if (_legacyClientId == 0 && _clients is { Count: > 0 })
            {
                _legacyClientId = _clients[0].Id;
            }
        }
        catch (JsonException)
        {
            _legacyError = "That file isn't valid JSON, or isn't in the expected legacy format.";
        }
    }

    private async Task ConvertLegacyAsync()
    {
        if (_legacyExport is null || _legacyFrom is null || _legacyTo is null || _legacyClientId == 0 || _legacyProjectId == 0)
        {
            return;
        }

        var client = _clients!.Single(c => c.Id == _legacyClientId);
        var project = _projects!.Single(p => p.Id == _legacyProjectId);

        _document = LegacyImportConverter.Convert(
            _legacyExport,
            DateOnly.FromDateTime(_legacyFrom.Value),
            DateOnly.FromDateTime(_legacyTo.Value),
            client.Name,
            project.Name);
        _preview = await ExportImportService.BuildPreviewAsync(_document);
        _resolution = null;
        _resultMessage = null;
    }

    private async Task ApplyAsync()
    {
        if (_document is null)
        {
            return;
        }

        var resolution = _resolution ?? ConflictResolution.Skip;
        var result = await ExportImportService.ApplyAsync(_document, resolution);

        _resultMessage = $"Imported {result.TimeEntriesImported} time entries ({result.TimeEntriesSkipped} skipped), " +
                          $"{result.DaysOffImported} days off ({result.DaysOffSkipped} skipped), " +
                          $"{result.NominalHoursSettingsImported} nominal-hours setting(s).";
        _document = null;
        _preview = null;
        _resolution = null;

        MqttPublisher.RequestRefresh();
        Snackbar.Add("Import applied.", Severity.Success);
    }
}
