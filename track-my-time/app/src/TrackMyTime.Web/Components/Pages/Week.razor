@page "/week"
@rendermode InteractiveServer
@using Microsoft.Extensions.Localization
@using TrackMyTime.Web.Models
@using TrackMyTime.Web.Repositories
@using TrackMyTime.Web.Services
@inject ITimeEntryRepository TimeEntryRepository
@inject IDayOffRepository DayOffRepository
@inject TimeSummaryService SummaryService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> Localizer

<MudText Typo="Typo.h4" GutterBottom="true">@Localizer["Week_Title", _from.ToString("d MMM"), _to.ToString("d MMM")]</MudText>

<MudButtonGroup Class="mb-4">
    <MudButton OnClick="@(() => ChangeWeekAsync(-1))" StartIcon="@Icons.Material.Filled.ChevronLeft">@Localizer["Common_Previous"]</MudButton>
    <MudButton OnClick="@(() => ChangeWeekAsync(1))" EndIcon="@Icons.Material.Filled.ChevronRight">@Localizer["Common_Next"]</MudButton>
</MudButtonGroup>

@if (_summary is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.subtitle1">
            @Localizer["Week_Summary", _summary.ActualHours.ToString("0.##"), _summary.NominalHours.ToString("0.##"), _summary.ActualWeekendHours.ToString("0.##")]
        </MudText>
        <MudProgressLinear Color="@(_summary.DeltaHours < 0 ? Color.Warning : Color.Success)"
                            Value="@ProgressPercent" Class="my-2" Size="Size.Large" />
        <MudText Typo="Typo.body2" Color="@(_summary.DeltaHours < 0 ? Color.Warning : Color.Success)">
            @FormatDelta()
        </MudText>
    </MudPaper>

    @for (var i = 0; i < _days.Count; i++)
    {
        var day = _days[i];
        var showMonthHeader = i == 0
            || day.Date.Month != _days[i - 1].Date.Month
            || day.Date.Year != _days[i - 1].Date.Year;

        @if (showMonthHeader)
        {
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mt-4 mb-2">@day.Date.ToString("MMMM yyyy")</MudText>
        }

        <MudCard Class="mb-2" Elevation="1">
            <MudCardContent Class="d-flex align-center pa-3">
                <div class="weekday-avatar mr-3">
                    <MudAvatar Color="@DayColor(day)" Variant="Variant.Filled">
                        <MudIcon Icon="@DayIcon(day)" />
                    </MudAvatar>
                    <div class="weekday-dots">
                        @{ var todayIndex = NominalHoursCalculator.MondayFirstIndex(day.Date.DayOfWeek); }
                        @for (var wd = 0; wd < 7; wd++)
                        {
                            <span class="weekday-dot@(wd == todayIndex ? " weekday-dot-active" : "")"></span>
                        }
                    </div>
                </div>
                <div class="flex-grow-1">
                    <MudText Typo="Typo.subtitle1">@day.Date.ToString("dddd d MMM")</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @day.Hours.ToString("0.##") h
                        @if (NominalHoursCalculator.IsWeekend(day.Date))
                        {
                            <MudChip T="string" Size="Size.Small" Class="ml-2">@Localizer["Week_Weekend"]</MudChip>
                        }
                        @if (day.IsDayOff)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ml-2">@Localizer["Week_DayOff"]</MudChip>
                        }
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditDay(day.Date))" />
            </MudCardContent>
        </MudCard>
    }
}

@code {
    private DateOnly _from;
    private DateOnly _to;
    private PeriodSummary? _summary;
    private List<DayRow> _days = [];

    private double ProgressPercent => _summary is { NominalHours: > 0 }
        ? (double)Math.Min(100m, _summary.ActualHours / _summary.NominalHours * 100m)
        : 0;

    protected override async Task OnInitializedAsync()
    {
        var (from, to) = DateRanges.WeekContaining(DateOnly.FromDateTime(DateTime.Now));
        _from = from;
        _to = to;
        await LoadAsync();
    }

    private async Task ChangeWeekAsync(int weeks)
    {
        _from = _from.AddDays(7 * weeks);
        _to = _to.AddDays(7 * weeks);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _summary = await SummaryService.GetWeekAsync(_from);

        var entries = await TimeEntryRepository.GetByDateRangeAsync(_from, _to);
        var daysOff = (await DayOffRepository.GetByDateRangeAsync(_from, _to)).Select(d => d.Date).ToHashSet();
        var hoursByDay = entries.GroupBy(e => e.Date).ToDictionary(g => g.Key, g => g.Sum(e => e.DurationMinutes) / 60m);

        _days = [];
        for (var day = _from; day <= _to; day = day.AddDays(1))
        {
            _days.Add(new DayRow(day, hoursByDay.GetValueOrDefault(day), daysOff.Contains(day)));
        }
    }

    // Relative (no leading "/"), not absolute: this app runs behind Home Assistant's ingress
    // proxy under a path that changes across restarts (see the PathBase middleware in
    // Program.cs and <base href> in App.razor) - an absolute "/day/..." URL bypasses that base
    // and 404s under ingress, same as every other in-app link (see NavMenu.razor's relative
    // Href values).
    private void EditDay(DateOnly date) => NavigationManager.NavigateTo($"day/{date:yyyy-MM-dd}");

    private string FormatDelta()
    {
        var hours = Math.Abs(_summary!.DeltaHours).ToString("0.##");
        return _summary.DeltaHours >= 0 ? Localizer["Common_AheadBy", hours] : Localizer["Common_BehindBy", hours];
    }

    private static Color DayColor(DayRow day) => day.IsDayOff
        ? Color.Info
        : NominalHoursCalculator.IsWeekend(day.Date) ? Color.Default : Color.Primary;

    private static string DayIcon(DayRow day) => day.IsDayOff
        ? Icons.Material.Filled.EventBusy
        : NominalHoursCalculator.IsWeekend(day.Date) ? Icons.Material.Filled.Weekend : Icons.Material.Filled.Work;

    private sealed record DayRow(DateOnly Date, decimal Hours, bool IsDayOff);
}
