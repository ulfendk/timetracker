@page "/"
@page "/day/{DateParam?}"
@rendermode InteractiveServer
@using Microsoft.Data.Sqlite
@using Microsoft.Extensions.Localization
@using TrackMyTime.Web.Models
@using TrackMyTime.Web.Repositories
@using TrackMyTime.Web.Services
@inject ITimeEntryRepository TimeEntryRepository
@inject IDayOffRepository DayOffRepository
@inject IProjectRepository ProjectRepository
@inject TimeSummaryService SummaryService
@inject MqttPublisherService MqttPublisher
@inject ISnackbar Snackbar
@inject IStringLocalizer<SharedResource> Localizer

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="3">
    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
        <MudIcon Icon="@(IsToday ? Icons.Material.Filled.WbSunny : Icons.Material.Filled.Event)" />
    </MudAvatar>
    <div>
        <MudText Typo="Typo.h4">@(IsToday ? Localizer["Today_TodayHeading"] : _date.ToString("dddd"))</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_date.ToString("d MMMM yyyy")</MudText>
    </div>
    <MudSpacer />
    @if (!IsToday)
    {
        @* Relative (no leading "/"), not absolute - see the comment on Week.razor's EditDay for
           why: an absolute href bypasses <base href> and 404s under Home Assistant's ingress
           proxy. Matches NavMenu.razor's own relative Href="" for the same Today route. *@
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Today" Href="">@Localizer["Today_BackToToday"]</MudButton>
    }
</MudStack>

@if (_projects is null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@Localizer["Today_ThisWeek"]</MudText>
                <MudText Typo="Typo.h6">@FormatWeek(_thisWeek)</MudText>
                <MudText Typo="Typo.body2" Color="@DeltaColor(_thisWeek)">@FormatDelta(_thisWeek)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudPaper Class="pa-3" Elevation="1">
                <MudText Typo="Typo.overline" Color="Color.Secondary">@Localizer["Today_LastWeek"]</MudText>
                <MudText Typo="Typo.h6">@FormatWeek(_lastWeek)</MudText>
                <MudText Typo="Typo.body2" Color="@DeltaColor(_lastWeek)">@FormatDelta(_lastWeek)</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" GutterBottom="true">@Localizer["Today_LogTime"]</MudText>

                @if (_projects.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">@Localizer["Today_AddClientProjectFirst"]</MudAlert>
                }
                else
                {
                    <MudSelect T="int" Label="@Localizer["Today_Project"]" @bind-Value="_form.ProjectId" Class="mb-3">
                        @foreach (var project in _projects)
                        {
                            <MudSelectItem T="int" Value="@project.Id">@project.ClientName — @project.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudGrid Class="mb-3">
                        <MudItem xs="6">
                            <MudTimePicker Label="@Localizer["Today_Start"]" @bind-Time="_form.Start" Editable="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTimePicker Label="@Localizer["Today_End"]" @bind-Time="_form.End" Editable="true" />
                        </MudItem>
                    </MudGrid>
                    <MudNumericField T="int" Label="@Localizer["Today_BreakMinutes"]" @bind-Value="_form.BreakMinutes" Min="0" Class="mb-3" />
                    <MudTextField Label="@Localizer["Common_Note"]" @bind-Value="_form.Note" Class="mb-3" />
                    @if (_formError is not null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-3" Dense="true">@_formError</MudAlert>
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEntryAsync" Disabled="@(_form.ProjectId == 0)">
                        @Localizer["Today_AddEntry"]
                    </MudButton>
                }

                <MudDivider Class="my-4" />

                <MudSwitch T="bool" Value="_isDayOff" ValueChanged="ToggleDayOffAsync" Color="Color.Primary"
                           Label="@(IsToday ? Localizer["Today_MarkTodayOff"] : Localizer["Today_MarkDayOff"])" />
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="7">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    @(IsToday
                        ? Localizer["Today_LoggedTodayHeading", _totalHours.ToString("0.##")]
                        : Localizer["Today_LoggedThatDayHeading", _totalHours.ToString("0.##")])
                </MudText>
                @if (_entries!.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["Today_NothingLoggedYet"]</MudText>
                }
                else
                {
                    <MudTable Items="_entries" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>@Localizer["Today_ClientProject"]</MudTh>
                            <MudTh>@Localizer["Today_Time"]</MudTh>
                            <MudTh>@Localizer["Common_Hours"]</MudTh>
                            <MudTh>@Localizer["Common_Note"]</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.ClientName — @context.ProjectName</MudTd>
                            <MudTd>
                                @if (context.StartTime is not null && context.EndTime is not null)
                                {
                                    @($"{context.StartTime:HH:mm}–{context.EndTime:HH:mm}")
                                    @if (context.BreakMinutes is > 0)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">(@context.BreakMinutes @Localizer["Today_MinBreak"])</MudText>
                                    }
                                }
                            </MudTd>
                            <MudTd>@((context.DurationMinutes / 60m).ToString("0.##"))</MudTd>
                            <MudTd>@context.Note</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => DeleteEntryAsync(context.Id))" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public string? DateParam { get; set; }

    private DateOnly _date;
    private List<ProjectWithClient>? _projects;
    private List<TimeEntryWithNames>? _entries = [];
    private decimal _totalHours;
    private bool _isDayOff;
    private PeriodSummary? _thisWeek;
    private PeriodSummary? _lastWeek;
    private readonly NewEntryForm _form = new();
    private string? _formError;

    private bool IsToday => _date == DateOnly.FromDateTime(DateTime.Now);

    protected override async Task OnParametersSetAsync()
    {
        _date = DateParam is not null && DateOnly.TryParseExact(DateParam, "yyyy-MM-dd", out var parsed)
            ? parsed
            : DateOnly.FromDateTime(DateTime.Now);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _projects = (await ProjectRepository.GetAllAsync()).ToList();
        var summary = await SummaryService.GetTodayAsync(_date);
        _entries = summary.Entries.ToList();
        _totalHours = summary.TotalHours;
        _isDayOff = summary.IsDayOff;
        _thisWeek = await SummaryService.GetWeekAsync(_date);
        _lastWeek = await SummaryService.GetWeekAsync(_date, weeksOffset: -1);
        if (_form.ProjectId == 0 && _projects.Count > 0)
        {
            _form.ProjectId = _projects[0].Id;
        }
    }

    private string FormatWeek(PeriodSummary? summary) =>
        summary is null ? "—" : $"{summary.ActualHours:0.##} / {summary.NominalHours:0.##} h";

    private string FormatDelta(PeriodSummary? summary)
    {
        if (summary is null)
        {
            return string.Empty;
        }
        var hours = Math.Abs(summary.DeltaHours).ToString("0.##");
        return summary.DeltaHours >= 0 ? Localizer["Common_AheadBy", hours] : Localizer["Common_BehindBy", hours];
    }

    private static Color DeltaColor(PeriodSummary? summary) =>
        summary is { DeltaHours: < 0 } ? Color.Warning : Color.Success;

    private async Task SaveEntryAsync()
    {
        _formError = null;
        if (_form.ProjectId == 0 || _form.Start is null || _form.End is null)
        {
            _formError = Localizer["Today_StartEndRequired"];
            return;
        }

        var start = TimeOnly.FromTimeSpan(_form.Start.Value);
        var end = TimeOnly.FromTimeSpan(_form.End.Value);
        if (end <= start)
        {
            _formError = Localizer["Today_EndAfterStart"];
            return;
        }

        var minutes = (int)(end - start).TotalMinutes - _form.BreakMinutes;
        if (minutes <= 0)
        {
            _formError = Localizer["Today_BreakTooLong"];
            return;
        }

        try
        {
            await TimeEntryRepository.CreateAsync(new TimeEntry
            {
                Date = _date,
                ProjectId = _form.ProjectId,
                DurationMinutes = minutes,
                Note = string.IsNullOrWhiteSpace(_form.Note) ? null : _form.Note,
                StartTime = start,
                EndTime = end,
                BreakMinutes = _form.BreakMinutes,
            });
        }
        catch (SqliteException ex)
        {
            _formError = Localizer["Today_CouldNotSave", ex.Message];
            return;
        }

        _form.Start = null;
        _form.End = null;
        _form.BreakMinutes = 0;
        _form.Note = null;
        MqttPublisher.RequestRefresh();
        await LoadAsync();
    }

    private async Task DeleteEntryAsync(int id)
    {
        await TimeEntryRepository.DeleteAsync(id);
        MqttPublisher.RequestRefresh();
        await LoadAsync();
    }

    private async Task ToggleDayOffAsync(bool value)
    {
        var existing = await DayOffRepository.GetByDateAsync(_date);
        if (value && existing is null)
        {
            await DayOffRepository.CreateAsync(new DayOff { Date = _date });
        }
        else if (!value && existing is not null)
        {
            await DayOffRepository.DeleteAsync(existing.Id);
        }
        MqttPublisher.RequestRefresh();
        await LoadAsync();
    }

    private sealed class NewEntryForm
    {
        public int ProjectId { get; set; }
        public TimeSpan? Start { get; set; }
        public TimeSpan? End { get; set; }
        public int BreakMinutes { get; set; }
        public string? Note { get; set; }
    }
}
