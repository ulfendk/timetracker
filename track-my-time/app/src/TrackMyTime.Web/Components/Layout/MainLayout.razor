@inherits LayoutComponentBase
@using System.Security.Cryptography
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.Extensions.Localization
@using MudBlazor.Services
@implements IAsyncDisposable
@inject IBrowserViewportService BrowserViewportService
@inject IJSRuntime JsRuntime
@inject ProtectedLocalStorage ProtectedLocalStorage
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SharedResource> Localizer

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">🧨 Track My Time</MudText>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Language" Color="Color.Inherit" AriaLabel="@Localizer["Layout_Language"].Value">
            <MudMenuItem OnClick="@(() => SetCulture("en"))">English</MudMenuItem>
            <MudMenuItem OnClick="@(() => SetCulture("da"))">Dansk</MudMenuItem>
        </MudMenu>
        <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                        Color="Color.Inherit" OnClick="@ToggleDarkModeAsync"
                        title="@(_isDarkMode ? Localizer["Layout_SwitchToLight"].Value : Localizer["Layout_SwitchToDark"].Value)" />
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1"
               Variant="@DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4 pb-8">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["ErrorBanner_Message"]
    <a href="." class="reload">@Localizer["ErrorBanner_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Loosely echoes Home Assistant's own Material palette (its default primary blue) so the
    // app doesn't feel like a foreign tool bolted onto an HA dashboard.
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new MudBlazor.PaletteLight
        {
            Primary = "#03A9F4",
            AppbarBackground = "#03A9F4",
            // MudBlazor's default Secondary is a bright pink - overridden here to a plain gray,
            // since we only use Color.Secondary for muted helper text, never as an accent.
            Secondary = "#616161",
        },
        PaletteDark = new MudBlazor.PaletteDark
        {
            Primary = "#03A9F4",
            Secondary = "#9E9E9E",
        },
    };

    // Full drawer, always open, on desktop (Md and up); a fully-hidden off-canvas overlay
    // toggled by the burger button below that ("Responsive" = Persistent above the breakpoint,
    // Temporary below it). MudDrawer's own Breakpoint parameter only affects how it BEHAVES
    // (persistent vs. overlay), not its initial Open state - without this subscription it stays
    // fully expanded (and thus covering the page) on first load on a phone, so the actual
    // open/closed default has to be driven from the real viewport size explicitly.
    private bool _drawerOpen = true;
    private readonly Guid _viewportSubscriptionId = Guid.NewGuid();

    // Dark mode (#16): an explicit user choice (via the app-bar toggle) is persisted in
    // ProtectedLocalStorage and always wins; absent that, we follow the browser's own
    // prefers-color-scheme on first render. ProtectedLocalStorage relies on the app's Data
    // Protection keys, which are already persisted under /data (see Program.cs), so the choice
    // survives container restarts/upgrades too.
    private const string DarkModeStorageKey = "trackmytime.darkMode";
    private bool _isDarkMode;

    protected override async Task OnInitializedAsync() =>
        await BrowserViewportService.SubscribeAsync(_viewportSubscriptionId, OnResizedAsync, new ResizeOptions(), fireImmediately: true);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _isDarkMode = await TryGetStoredDarkModeAsync() ?? await JsRuntime.InvokeAsync<bool>("themeInterop.prefersDark");
        StateHasChanged();
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await ProtectedLocalStorage.SetAsync(DarkModeStorageKey, _isDarkMode);
    }

    // ProtectedLocalStorage decrypts with the app's current Data Protection key ring - a value
    // written by an earlier key (e.g. the ring was regenerated, or /data was wiped) throws
    // CryptographicException instead of just "not found", which otherwise crashes the whole
    // circuit here (this runs from OnAfterRenderAsync, with no surrounding error boundary).
    // Falling back to the system preference is a much better failure mode than a dead page.
    private async Task<bool?> TryGetStoredDarkModeAsync()
    {
        try
        {
            var stored = await ProtectedLocalStorage.GetAsync<bool>(DarkModeStorageKey);
            return stored.Success ? stored.Value : null;
        }
        catch (CryptographicException)
        {
            return null;
        }
    }

    private async Task OnResizedAsync(BrowserViewportEventArgs args)
    {
        // Note the argument order: (rangeToTestAgainst, actualCurrentBreakpoint) - passing
        // these the other way round silently answers a different question and always returns
        // false for anything at or above Md.
        _drawerOpen = await BrowserViewportService.IsBreakpointWithinReferenceSizeAsync(Breakpoint.MdAndUp, args.Breakpoint);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    // Backlog #17: Blazor Server can't hot-swap culture mid-circuit, so this is a real navigation
    // (forceLoad: true) to the /culture/set endpoint (Program.cs), which sets the culture cookie
    // and redirects back here - a genuine full-page round trip, not a SignalR interaction.
    private void SetCulture(string culture)
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.NavigateTo($"culture/set?culture={culture}&redirectUri={Uri.EscapeDataString(relative)}", forceLoad: true);
    }

    public async ValueTask DisposeAsync() => await BrowserViewportService.UnsubscribeAsync(_viewportSubscriptionId);
}
